# Supabase REST access used by Python scraper/loader utilities.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Direct Postgres URL for the live Supabase/Postgres source database.
# Required by scripts/export_live_schema.ps1 and scripts/export_reference_seed.ps1.
SOURCE_DATABASE_URL=postgresql://user:password@host:5432/postgres

# Local Postgres admin/maintenance URL, usually ending in /postgres.
# Required by scripts/rebuild_local_db.ps1 when creating/dropping local DBs.
LOCAL_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Local Postgres target database URL for restore/rebuild workflows.
LOCAL_TARGET_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grad_tracker_rebuild

# Direct Postgres URL used by scripts/validate_data.py.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grad_tracker_rebuild

# Optional override for scripts/rebuild_local_db.ps1.
LOCAL_DATABASE_NAME=grad_tracker_rebuild